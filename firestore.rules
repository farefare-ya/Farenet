/**
 * Firestore Security Rules for Farenet
 * -------------------------------------------------------------
 * HOW TO APPLY:
 *   Firebase Console → your project → Firestore Database → Rules tab
 *   → paste this whole file, replacing what's there → Publish.
 *
 * This replaces the wide-open "test mode" rules. Without this, ANYONE
 * with your Firebase config (which is public by design, see earlier
 * discussion) can read/write your entire database directly via the
 * Firebase SDK in a browser console — bypassing your app's UI
 * entirely. That means group passwords, kick, block, etc. are purely
 * cosmetic until these rules are applied.
 * -------------------------------------------------------------
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- users ----------
    match /users/{userId} {
      // Anyone signed in can read profiles (needed for search/avatars/Explore).
      allow read: if isSignedIn();
      // You can only create/edit your own profile document.
      allow create: if isMe(userId);
      allow update: if isMe(userId);
      allow delete: if false; // accounts are removed via the admin cleanup script only
    }

    // ---------- chats ----------
    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }
      function willBeMember() {
        return isSignedIn() && request.auth.uid in request.resource.data.members;
      }
      function isAdmin() {
        return isSignedIn() && request.auth.uid in resource.data.admins;
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Members can read their own chats; public groups are readable by
      // anyone signed in (so Explore can list them before joining).
      allow read: if isMember() || resource.data.isPublic == true;

      // Creating a chat: you must include yourself as a member.
      allow create: if willBeMember();

      // Any member can update their own typing flag.
      allow update: if isMember() && changedKeys().hasOnly(['typing']);

      // Any member can update the "last message" preview fields (sending a message).
      allow update: if isMember() &&
        changedKeys().hasOnly(['lastMessage', 'lastMessageTime', 'lastSenderId']);

      // Pinning: group admins only; either side of a 1:1 chat.
      allow update: if isMember() &&
        changedKeys().hasOnly(['pinnedMessage']) &&
        (resource.data.isGroup == false || isAdmin());

      // Admins can manage group settings, membership, and admin list.
      allow update: if isMember() && isAdmin() &&
        changedKeys().hasOnly(['name', 'photoURL', 'announcement', 'wallpaper', 'isPublic', 'passwordHash', 'members', 'admins']);

      // Anyone can join a PUBLIC group themselves (adds only their own uid).
      allow update: if isSignedIn() && resource.data.isPublic == true &&
        changedKeys().hasOnly(['members']) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.auth.uid in request.resource.data.members;

      // Any member can leave a chat (removes only themselves).
      allow update: if isMember() &&
        changedKeys().hasOnly(['members', 'admins']) &&
        !(request.auth.uid in request.resource.data.members);

      allow delete: if false;

      // ---------- messages ----------
      match /messages/{messageId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        allow read: if isSignedIn() && request.auth.uid in chatMembers();

        allow create: if isSignedIn() &&
          request.auth.uid in chatMembers() &&
          request.resource.data.senderId == request.auth.uid;

        // Only the sender can edit their own message, and only to soft-delete it.
        allow update: if isSignedIn() &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'text', 'imageData']);

        allow delete: if false;
      }
    }
  }
}
